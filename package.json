{
    "name": "bashbook",
    "displayName": "BashBook",
    "description": "Notebook for running bash/shell script",
    "version": "0.6.0",
    "publisher": "AndreasArvidsson",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/AndreasArvidsson/bashbook.git"
    },
    "sponsor": {
        "url": "https://github.com/sponsors/AndreasArvidsson"
    },
    "funding": "https://github.com/sponsors/AndreasArvidsson",
    "engines": {
        "vscode": "^1.113.0"
    },
    "categories": [
        "Notebooks"
    ],
    "activationEvents": [
        "onNotebookEditor:bashbook",
        "onNotebook:bashbook"
    ],
    "main": "./out/extension.js",
    "icon": "images/icon.png",
    "files": [
        "out",
        "images",
        "node_modules/node-pty",
        "LICENSE",
        "README.md",
        "package.json"
    ],
    "contributes": {
        "commands": [
            {
                "command": "bashbook.newNotebook",
                "title": "BashBook: Create new Bash Notebook",
                "shortTitle": "Bash Notebook"
            },
            {
                "command": "bashbook.openNotebookAsMarkdown",
                "title": "BashBook: Open notebook as markdown",
                "shortTitle": "Open notebook as markdown"
            },
            {
                "command": "bashbook.openAllOutputsInNewFile",
                "title": "BashBook: Open all outputs in new file",
                "shortTitle": "Open all outputs"
            },
            {
                "command": "bashbook.cell.executeAndSelect",
                "title": "BashBook: Execute cell and select content"
            },
            {
                "command": "bashbook.cell.executeAndClear",
                "title": "BashBook: Execute cell and clear content"
            },
            {
                "command": "bashbook.cell.executeWithMarkdownOutput",
                "title": "BashBook: Execute and show output in below markdown cell"
            },
            {
                "command": "bashbook.cell.clearAndEdit",
                "title": "BashBook: Clear cell content and edit"
            },
            {
                "command": "bashbook.cell.copyOutput",
                "title": "BashBook: Copy cell output",
                "shortTitle": "Copy cell output"
            },
            {
                "command": "bashbook.cell.openOutputInNewFile",
                "title": "BashBook: Open cell output in new file",
                "shortTitle": "Open cell output"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "bashbook.openNotebookAsMarkdown",
                    "when": "notebookType == bashbook"
                },
                {
                    "command": "bashbook.openAllOutputsInNewFile",
                    "when": "notebookType == bashbook && notebookHasOutputs"
                },
                {
                    "command": "bashbook.cell.executeAndSelect",
                    "when": "notebookType == bashbook && notebookCellType == code"
                },
                {
                    "command": "bashbook.cell.executeAndClear",
                    "when": "notebookType == bashbook && notebookCellType == code"
                },
                {
                    "command": "bashbook.cell.executeWithMarkdownOutput",
                    "when": "notebookType == bashbook && notebookCellType == code"
                },
                {
                    "command": "bashbook.cell.clearAndEdit",
                    "when": "notebookType == bashbook && notebookCellType == code"
                },
                {
                    "command": "bashbook.cell.openOutputInNewFile",
                    "when": "notebookType == bashbook && notebookCellType == code && notebookCellHasOutputs"
                },
                {
                    "command": "bashbook.cell.copyOutput",
                    "when": "notebookType == bashbook && notebookCellType == code && notebookCellHasOutputs"
                }
            ],
            "file/newFile": [
                {
                    "command": "bashbook.newNotebook"
                }
            ],
            "notebook/toolbar": [
                {
                    "command": "bashbook.openNotebookAsMarkdown",
                    "group": "z_commands",
                    "when": "notebookType == bashbook"
                },
                {
                    "command": "bashbook.openAllOutputsInNewFile",
                    "group": "z_commands",
                    "when": "notebookType == bashbook && notebookHasOutputs"
                }
            ],
            "notebook/cell/title": [
                {
                    "command": "bashbook.cell.copyOutput",
                    "group": "z_commands",
                    "when": "notebookType == bashbook && notebookCellType == code && notebookCellHasOutputs"
                },
                {
                    "command": "bashbook.cell.openOutputInNewFile",
                    "group": "z_commands",
                    "when": "notebookType == bashbook && notebookCellType == code && notebookCellHasOutputs"
                }
            ]
        },
        "startEntries": [
            {
                "title": "BashBook",
                "description": "Notebook for running bash/shell script",
                "command": "bashbook.newNotebook",
                "category": "notebook"
            }
        ],
        "configuration": {
            "title": "BashBook",
            "properties": {
                "bashbook.profile": {
                    "type": "string",
                    "enum": [
                        "Bash",
                        "Git Bash",
                        "Csh"
                    ],
                    "default": "Bash",
                    "description": "Sets default values and behavior for the shell",
                    "order": 0
                },
                "bashbook.shell": {
                    "type": "string",
                    "description": "Shell executable (eg: bash, bash.exe)",
                    "order": 1
                },
                "bashbook.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable debug logging for BashBook",
                    "order": 2
                }
            }
        },
        "notebooks": [
            {
                "id": "bashbook",
                "type": "bashbook",
                "displayName": "BashBook",
                "selector": [
                    {
                        "filenamePattern": "*.bashbook"
                    }
                ]
            }
        ],
        "notebookRenderer": [
            {
                "id": "bashbook-renderer",
                "entrypoint": "./out/renderer.mjs",
                "displayName": "BashBook",
                "requiresMessaging": "always",
                "mimeTypes": [
                    "x-application/bashbook"
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "clean": "rm -rf out",
        "build": "npm run build:extension && npm run build:renderer",
        "build:extension": "vite build --mode extension",
        "build:renderer": "vite build --mode renderer",
        "rebuild": "electron-rebuild -f",
        "watch:extension": "vite build --mode extension --watch",
        "watch:renderer": "vite build --mode renderer --watch",
        "package": "vsce package",
        "typecheck": "tsc -p .",
        "lint": "npm run typecheck && npm run lint:ts && npm run lint:fmt",
        "lint:ts": "oxlint -c oxlint.config.mts --deny-warnings .",
        "lint:fmt": "oxfmt --check .",
        "fix": "npm run fix:ts && npm run fix:fmt",
        "fix:ts": "oxlint -c oxlint.config.mts --fix .",
        "fix:fmt": "oxfmt .",
        "test": "tsx ./src/test/runAllTests.ts"
    },
    "extensionDependencies": [
        "pokey.parse-tree"
    ],
    "dependencies": {
        "node-pty": "^1.1.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.12.0",
        "@types/vscode-notebook-renderer": "^1.72.4",
        "@types/vscode": "^1.110.0",
        "@xterm/xterm": "^6.0.0",
        "electron": "39.8.3",
        "fast-glob": "^3.3.3",
        "mocha": "^11.7.5",
        "oxfmt": "^0.43.0",
        "oxlint-tsgolint": "^0.19.0",
        "oxlint": "^1.58.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.3",
        "web-tree-sitter": "^0.26.8"
    }
}
